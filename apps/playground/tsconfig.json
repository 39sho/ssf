{
  "extends": "@ssf/configs/tsconfig.json",
  "include": ["app", ".react-router/types/**/*"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDirs": [".", "./.react-router/types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "~/*": ["./.react-router/types/app/*"]
    }
  }
}
