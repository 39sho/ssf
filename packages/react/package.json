{
  "name": "@39sho/ssf-react",
  "version": "0.0.4",
  "type": "module",
  "description": "React bindings for SSF – auto-generate forms from Standard Schema",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/39sho/ssf.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/39sho/ssf/tree/main/packages/react#readme",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@39sho/ssf-core": "workspace:*",
    "@standard-schema/spec": "^1.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-form": "^1.28.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@ssf/configs": "workspace:*",
    "@tanstack/react-form": "^1.28.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.3",
    "tsdown": "^0.20.3"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "fmt": "biome check . --write",
    "fmt:check": "biome check ."
  }
}
